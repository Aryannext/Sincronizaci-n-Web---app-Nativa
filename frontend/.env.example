# URL del backend Node.js (sin /api al final).
# Para abrir el panel desde otro equipo de la red, usa la IP del PC que corre el backend,
# por ejemplo http://192.168.1.50:3000
VITE_API_URL=http://localhost:3000

# Ruta donde se publica el panel al compilarlo (por defecto "/"). En el VPS es /sincronizacion/
# y la fija despliegue/web.Dockerfile; en local no hace falta.
# VITE_BASE=/
