PORT = 3000

# 0.0.0.0 acepta conexiones de la red local. Si la API va detrás de un proxy HTTPS
# en el mismo servidor, usa 127.0.0.1 para que solo el proxy pueda llegar a ella.
HOST = 0.0.0.0

DB_HOST = localhost
DB_PORT = 5432
DB_USER = postgres
DB_PASSWORD = tu_contrasena
# Nombre de tu base de datos
DB_NAME = crud_offline

# --- Seguridad ---

# Obligatorio, mínimo 32 caracteres. Genera uno con:
#   node -e "console.log(require('crypto').randomBytes(48).toString('hex'))"
JWT_SECRET =

# Duración de la sesión por rol (formato: 8h, 30d...)
JWT_EXPIRES_ADMIN = 8h
JWT_EXPIRES_OPERADOR = 30d

# Orígenes del panel web autorizados (separados por coma). Ej. en producción:
#   CORS_ORIGINS = https://panel.tuempresa.com
CORS_ORIGINS = http://localhost:5173

# Número de proxies delante de la API (1 si usas Nginx/Caddy/Cloudflare con HTTPS, 0 si no)
TRUST_PROXY = 0

# Peticiones permitidas por IP cada 15 minutos
RATE_LIMIT_MAX = 1000
RATE_LIMIT_LOGIN_MAX = 10
