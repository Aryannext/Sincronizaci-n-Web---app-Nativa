# Configuración del despliegue en el VPS. instalar.sh copia este archivo a despliegue/.env y genera los secretos.
# Sin espacios alrededor del "=": Docker Compose no los admite como dotenv.

# Puerto local donde escucha el contenedor web. Debe coincidir con nginx/sincronizacion.conf
# y no estar usado por otro proyecto del servidor (compruébalo con: ss -ltn)
SINCRONIZACION_PUERTO=3020

# URL pública de la API sin /api al final (la usa el panel al compilarse)
PANEL_API_URL=https://proyectosena.online/sincronizacion

# Base de datos del contenedor db
DB_USER=sincronizacion
DB_NAME=sincronizacion
DB_PASSWORD=

# Mínimo 32 caracteres; instalar.sh lo genera
JWT_SECRET=
JWT_EXPIRES_ADMIN=8h
JWT_EXPIRES_OPERADOR=30d

# El panel se abre desde este origen
CORS_ORIGINS=https://proyectosena.online

# Un proxy de confianza delante de la API: el Nginx del servidor, que fija la IP real del cliente
TRUST_PROXY=1

RATE_LIMIT_MAX=1000
RATE_LIMIT_LOGIN_MAX=10
