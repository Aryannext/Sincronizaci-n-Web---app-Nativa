# Variables del despliegue. En Dokploy se pegan en la pestaña Environment de la aplicación;
# para levantarlo a mano, copia este archivo como despliegue/.env (no se versiona).
# Sin espacios alrededor del "=": Docker Compose no los admite.

# Obligatorias. Genéralas con: openssl rand -hex 24  /  openssl rand -hex 48
# La contraseña de la base solo se fija al crearla: si la base ya existe, usa la que tenía.
DB_PASSWORD=
JWT_SECRET=

# Opcionales: estos son los valores por defecto
DB_USER=sincronizacion
DB_NAME=sincronizacion
JWT_EXPIRES_ADMIN=8h
JWT_EXPIRES_OPERADOR=30d
# Origen desde el que se abre el panel
CORS_ORIGINS=https://proyectosena.online
RATE_LIMIT_MAX=1000
RATE_LIMIT_LOGIN_MAX=10

# Puerto local del contenedor web. Debe coincidir con nginx/sincronizacion.conf
# y no estar usado por otro proyecto del servidor (compruébalo con: ss -ltn)
SINCRONIZACION_PUERTO=3020
# URL pública de la API sin /api al final (la usa el panel al compilarse)
PANEL_API_URL=https://proyectosena.online/sincronizacion
